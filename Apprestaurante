
import os

restaurantes = [
    {
        'nome': 'RestauranteOFC',
        'categoria': 'Oriental',
        'ativo': True
    }
]


def limpar_tela():
    os.system('cls' if os.name == 'nt' else 'clear')


def exibir_nome():
    print("☆ Restaurante ☆")


def exibir_opcoes():
    print('\n1. Cadastrar restaurante')
    print('2. Listar restaurantes')
    print('3. Ativar ou desativar restaurante')
    print('4. Sair')


def pausar():
    input('\nPressione ENTER para voltar ao menu...')


def cadastrar_restaurante():
    limpar_tela()
    print("☆ Cadastrar novo restaurante ☆\n")

    nome_res = input("Digite o nome do restaurante: ").strip()

    if not nome_res:
        print("\nO nome do restaurante não pode ser vazio.")
        return

    for restaurante in restaurantes:
        if restaurante['nome'].lower() == nome_res.lower():
            print("\nEsse restaurante já está cadastrado!")
            return

    categoria = input(
        f"Digite a categoria do restaurante {nome_res}: "
    ).strip()

    if not categoria:
        print("\nA categoria não pode ser vazia.")
        return

    dados_do_restaurante = {
        'nome': nome_res,
        'categoria': categoria,
        'ativo': False
    }

    restaurantes.append(dados_do_restaurante)

    print(
        f"\nO restaurante {nome_res} "
        "foi cadastrado com sucesso!"
    )


def listar():
    limpar_tela()
    print("☆ Lista de restaurantes ☆\n")

    if not restaurantes:
        print("Nenhum restaurante cadastrado.")
        return

    print(
        f"{'Nome'.ljust(25)} | "
        f"{'Categoria'.ljust(20)} | "
        "Status"
    )

    print("-" * 65)

    for restaurante in restaurantes:
        nome = restaurante['nome']
        categoria = restaurante['categoria']

        status = (
            'Ativado'
            if restaurante['ativo']
            else 'Desativado'
        )

        print(
            f"{nome.ljust(25)} | "
            f"{categoria.ljust(20)} | "
            f"{status}"
        )


def on_off():
    limpar_tela()
    print("☆ Ativar ou desativar restaurante ☆\n")

    procurar = input(
        "Informe o nome do restaurante: "
    ).strip()

    encontrado = False

    for restaurante in restaurantes:

        if restaurante['nome'].lower() == procurar.lower():
            encontrado = True

            # Alterna entre True e False
            restaurante['ativo'] = not restaurante['ativo']

            if restaurante['ativo']:
                mensagem = (
                    f"O restaurante {restaurante['nome']} "
                    "foi ativado com sucesso!"
                )
            else:
                mensagem = (
                    f"O restaurante {restaurante['nome']} "
                    "foi desativado com sucesso!"
                )

            print(f"\n{mensagem}")
            break

    if not encontrado:
        print("\nRestaurante não encontrado!")


def escolher_opcao():
    try:
        opcao_escolhida = int(
            input('\nEscolha uma opção: ')
        )

        if opcao_escolhida == 1:
            cadastrar_restaurante()

        elif opcao_escolhida == 2:
            listar()

        elif opcao_escolhida == 3:
            on_off()

        elif opcao_escolhida == 4:
            return False

        else:
            print("\nOpção inválida!")

    except ValueError:
        print("\nDigite um número válido!")

    return True


def main():
    while True:
        limpar_tela()
        exibir_nome()
        exibir_opcoes()

        continuar = escolher_opcao()

        if not continuar:
            break

        pausar()

    finalizar_app()


def finalizar_app():
    limpar_tela()
    print("Finalizando o aplicativo...")
    print("Até logo!")


if __name__ == '__main__':
    main()
