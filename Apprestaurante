import os
# Simulador de códigos

restaurantes = [{'nome':'RatoranteOFC', 'categoria':'Oriental', 'ativo':True}]

def exibir_nome():
    print("☆Ratorante☆")

def exibir_opcoes():
    print('1. Cadastrar restaurante')
    print('2. Listar restaurante')
    print('3. Ativar restaurante')
    print('4. Sair\n')
    
def finalizar_app():
    os.system('cls')
    print('Finalizando o app...')

def menu():
    input('\nDigite uma tecla para voltar ao menu ')
    main()

def opcao_invalida():
    print("Opção inválida!\n")
    menu()
    main()

def cadastrar_restaurante():
    os.system('cls')
    print("☆Cadastrar novo restaurante: ")
    nome_res = input("Digite o nome do restaurante: ")
    categoria = input(f'Digite o nome da categoria do restaurante {nome_res}: ')
    dados_do_restaurante = {'nome':nome_res, 'categoria':categoria, 'ativo':False}
    restaurantes.append(dados_do_restaurante)
    print(f'O restaurante {nome_res} foi cadastrado com sucesso!')
    menu()
    main()

def listar():
    os.system('cls')
    print("☆Lista de restaurantes: ")

    print(f"{'Nome'.ljust(22)} | {'Categoria'.ljust(20)} | 'Status'")
    for restaurante in restaurantes:
        nomres = restaurante['nome']
        categoria = restaurante['categoria']
        ativo = 'ativado' if restaurante['ativo'] else 'desativado'
        print(f'- {nomres.ljust(20)} | {categoria.ljust(20)} | {ativo}')
    menu()

def on_off():
    os.system('cls')
    print("☆Ativar ou desativar restaurante: ")
    procurar = input("Informe o restaurante: ")
    encontrado = False

    for restaurante in restaurantes:
        if procurar == restaurante['nome']:
            encontrado = True
            restaurante['ativo'] = not restaurante['ativo']
            mensagem = (f'O restaurante {procurar} foi ativado com sucesso!'
                         if restaurante['ativo']
                         else f'O restaurante foi desativado com êxito.')
            print(mensagem)

    if not procurar: 
        print("Restaurante não encontrado!")
    menu()

def escolher_opcao():
    try:
        opcao_escolhida = int(input('Escolha uma opção: '))
        if opcao_escolhida == 1:
            cadastrar_restaurante()
        elif opcao_escolhida == 2:
            listar()
        elif opcao_escolhida == 3:
            on_off()
        elif opcao_escolhida == 4:
            finalizar_app()
        else:
            opcao_invalida()
    except Exception:
        opcao_invalida()

def main():
    os.system('cls')
    exibir_nome()
    exibir_opcoes()
    escolher_opcao()
    
if __name__ == '__main__':
    main()
